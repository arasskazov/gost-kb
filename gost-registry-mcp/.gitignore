# Сгенерированные артефакты (база и отчёты импорта) в git не кладутся —
# они восстанавливаются командой импорта. Исходные JSON-выгрузки в
# data/incoming/ включены в репозиторий явно (открытые данные, решение
# пользователя от 13.08.2026 — перенос всего проекта, включая данные).
data/reports/*
!data/reports/.gitkeep
data/*.sqlite
data/*.sqlite3
